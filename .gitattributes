# Without this, every site that installs the addon downloads its tests, CI
# config, listing artwork, build sources and node tooling along with the code
# it actually runs.

/.github            export-ignore
/tests              export-ignore
/art                export-ignore
/screenshots        export-ignore
/scripts            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.editorconfig      export-ignore
/phpunit.xml        export-ignore
/phpunit.xml.dist   export-ignore
/phpunit.mysql.xml  export-ignore
/pint.json          export-ignore
/phpstan.neon       export-ignore
/phpstan-baseline.neon export-ignore
/addon-lint.json    export-ignore
/package.json       export-ignore
/package-lock.json  export-ignore
/vite.config.js     export-ignore
/resources/js       export-ignore
/resources/css      export-ignore

# Kept: /config, /database, /resources/dist (the built Control Panel bundle
# consumers actually load — never export-ignore it), /resources/lang,
# /resources/svg, /routes, /src, README.md, CHANGELOG.md, LICENSE.
